#version 460 core

#include "entity_common.glsl"

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = BIND_SSBO_BUCKETS) readonly buffer RanksBlock {
    uvec2 b_ranks[];
};

layout(std430, binding = BIND_SSBO_INDIRECT) readonly buffer IndirectBlock {
    DrawCmd b_commands[];
};

layout(std430, binding = BIND_SSBO_VISIBLE) writeonly buffer VisibleBlock {
    uint b_visible[];
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= u_counts.x) return;

    uvec2 br = b_ranks[i];
    if (br.x == 0xFFFFFFFFu) return;

    uint base_inst = b_commands[br.x].baseInstance;
    b_visible[base_inst + br.y] = i;
}
