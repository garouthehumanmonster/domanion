#version 460 core

layout(local_size_x = 16, local_size_y = 16) in;

layout(binding = TEX_FOG_TVIS) uniform sampler2D u_tvis;
layout(binding = TEX_FOG_TEXP) uniform sampler2D u_texp;
layout(binding = IMG_FOG_SMOOTH, rg16f) uniform image2D u_fog_smooth;

uniform float u_dt;
uniform int u_n;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= u_n || p.y >= u_n) return;

    float tv = texelFetch(u_tvis, p, 0).r;
    float te = max(texelFetch(u_texp, p, 0).r, tv);

    vec2 target = vec2(tv, te);
    vec2 cur = imageLoad(u_fog_smooth, p).xy;

    for (int i = 0; i < 2; ++i) {
        float tgt = target[i];
        float c = cur[i];
        float rate = (tgt > c) ? 10.0 : 3.0;
        c += (tgt - c) * (1.0 - exp(-rate * u_dt));
        if (abs(tgt - c) < 0.002) {
            c = tgt;
        }
        cur[i] = c;
    }

    imageStore(u_fog_smooth, p, vec4(cur, 0.0, 0.0));
}
