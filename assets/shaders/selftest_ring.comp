#version 460 core

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = BIND_SSBO_TEST_IN) readonly buffer InBuffer {
    uint in_data[];
};

layout(std430, binding = BIND_SSBO_TEST_OUT) writeonly buffer OutBuffer {
    uint out_data[];
};

layout(location = 0) uniform uint u_count;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < u_count) {
        out_data[i] = in_data[i] * 2u + 1u;
    }
}
